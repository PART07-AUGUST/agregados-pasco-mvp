# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# GraphHopper Routing API (Rutas y fletes de carga pesada)
VITE_GRAPHHOPPER_API_KEY=your-graphhopper-api-key-here

# Google Maps Platform API (Mapas interactivos y navegación)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
# Google Gemini API (Copiloto Operativo de IA - Soporta GEMINI_API_KEY o VITE_GEMINI_API_KEY)
GEMINI_API_KEY=your-gemini-api-key-here
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Proveedores de Inteligencia Artificial Adicionales (Multiagente Heterogéneo)
# Proveedor por defecto: gemini | groq | openrouter | openai
VITE_LLM_PROVIDER=gemini

# Groq (Gratis - Inferencia ultra veloz con Llama-3.3-70B para Flota y Despacho)
VITE_GROQ_API_KEY=your-groq-api-key-here
# VITE_GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (Gratis - Acceso a DeepSeek-R1 y Qwen 2.5 chinos para Auditoría ML)
VITE_OPENROUTER_API_KEY=your-openrouter-api-key-here
# VITE_OPENROUTER_MODEL=deepseek/deepseek-r1:free

# OpenAI (Opcional - GPT-4o / GPT-4o-mini)
# VITE_OPENAI_API_KEY=your-openai-api-key-here

# Especialización por Rol (1 modelo dedicado por agente):
# VITE_SUPERVISOR_LLM_PROVIDER=gemini
# VITE_FLEET_LLM_PROVIDER=groq
# VITE_FUEL_LLM_PROVIDER=openrouter

# Backend API (Azure Container Apps - FastAPI)
VITE_API_BASE_URL=https://agregadospasco.lemonsand-30379335.eastus2.azurecontainerapps.io/api/v1
